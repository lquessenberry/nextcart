# Ignore directories generated by Composer
/backend/vendor/
/backend/vendor/*
/backend/web/core/
/backend/web/modules/contrib/
/backend/web/themes/contrib/
/backend/web/profiles/contrib/
/backend/web/libraries/

# Ignore sensitive information
/backend/web/sites/*/settings.php
/backend/web/sites/*/settings.local.php
/backend/web/sites/*/services*.yml

# Ignore Drupal's file directory
/backend/web/sites/*/files/

# Ignore SimpleTest multi-site environment
/backend/web/sites/simpletest

# Ignore composer files
/backend/composer.lock

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env
/backend/.env

# Ignore build files
/build/

# Ignore node_modules
/frontend/node_modules/
node_modules/

# Ignore Next.js build output
/frontend/.next/
/frontend/out/

# Ignore coverage output
/frontend/coverage

# Ignore debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local env files
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local

# Ignore Mac files
.DS_Store
